     storage_name = "google_calendar"
 
+    async def _put(self, href, item, etag):
+        # Google rejects detached instances with independent SEQUENCE values
+        # (409 even with a fresh ETag). Let Google assign those revisions.
+        # Preserve the master, source Item and DAV preconditions.
+        parsed = item.parsed
+        changed = False
+        if parsed is not None and parsed.name == "VCALENDAR":
+            for component in parsed.subcomponents:
+                if (
+                    component.name == "VEVENT"
+                    and "RECURRENCE-ID" in component
+                    and "SEQUENCE" in component
+                ):
+                    del component["SEQUENCE"]
+                    changed = True
+        if changed:
+            item = Item("\r\n".join(parsed.dump_lines()))
+        return await super()._put(href, item, etag)
