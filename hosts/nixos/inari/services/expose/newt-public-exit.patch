+
+func TestMatch_ExitNodeOnlyRoutesPublicIPv4(t *testing.T) {
+	sl := NewSubnetLookup()
+	sl.AddSubnet(SubnetRule{
+		SourcePrefix: clientPrefix,
+		DestPrefix:   netip.MustParsePrefix("0.0.0.0/0"),
+		ResourceId:   1,
+	})
+	sl.AddSubnet(SubnetRule{
+		SourcePrefix: clientPrefix,
+		DestPrefix:   netip.MustParsePrefix("127.0.0.1/32"),
+		PortRanges:   []PortRange{{Min: 443, Max: 443, Protocol: "tcp"}},
+		ResourceId:   2,
+	})
+
+	for _, tc := range []struct {
+		address string
+		port    uint16
+		want    int
+	}{
+		{"1.1.1.1", 443, 1},
+		{"127.0.0.1", 443, 2},
+		{"127.0.0.1", 8443, 0},
+		{"127.0.0.2", 443, 0},
+		{"192.168.178.1", 443, 0},
+		{"172.17.0.1", 443, 0},
+		{"10.0.2.1", 443, 0},
+		{"100.64.0.1", 443, 0},
+		{"169.254.1.1", 443, 0},
+		{"0.0.0.1", 443, 0},
+		{"224.0.0.1", 443, 0},
+	} {
+		rule := sl.Match(clientIP, netip.MustParseAddr(tc.address), tc.port, header.TCPProtocolNumber)
+		got := 0
+		if rule != nil {
+			got = rule.ResourceId
+		}
+		if got != tc.want {
+			t.Errorf("%s:%d matched rule %d, want %d", tc.address, tc.port, got, tc.want)
+		}
+	}
+}
+
+func TestMatch_PrivateAliasSurvivesMoreSpecificExitSource(t *testing.T) {
+	sl := NewSubnetLookup()
+	alias := netip.MustParseAddr("100.96.0.5")
+	sl.AddSubnet(SubnetRule{
+		SourcePrefix: netip.MustParsePrefix("10.0.0.0/24"),
+		DestPrefix:   netip.PrefixFrom(alias, 32),
+		PortRanges:   []PortRange{{Min: 443, Max: 443, Protocol: "tcp"}},
+		ResourceId:   1,
+	})
+	sl.AddSubnet(SubnetRule{
+		SourcePrefix: clientPrefix,
+		DestPrefix:   netip.MustParsePrefix("0.0.0.0/0"),
+		ResourceId:   2,
+	})
+	if rule := sl.Match(clientIP, alias, 443, header.TCPProtocolNumber); rule == nil || rule.ResourceId != 1 {
+		t.Fatalf("expected private alias to match with exit enabled, got %+v", rule)
+	}
+	if rule := sl.Match(clientIP, alias, 22, header.TCPProtocolNumber); rule != nil {
+		t.Fatalf("expected private alias on ungranted port to be denied, got %+v", rule)
+	}
+}
