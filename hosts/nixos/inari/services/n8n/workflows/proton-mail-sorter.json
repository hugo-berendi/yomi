  "id": "XXIrJFuixCFWP9rX",
  "name": "Proton Mail - sort unsorted automatically",
  "nodeGroups": [],
  "nodes": [
    {
      "id": "81117c2a-8ddd-4dd5-9c49-0ca0e14c1e3b",
      "name": "Every ten minutes",
      "parameters": {
        "rule": {
          "interval": [
            {
              "expression": "*/10 * * * *",
              "field": "cronExpression"
            }
          ]
        }
      },
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "f53d9cd1-da6a-4ad7-a174-d3228e0a38be",
      "name": "Manual check",
      "parameters": {},
      "position": [
        0,
        160
      ],
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_PROTON_SORTER_ACCESS",
          "name": "Proton sorter - Authorization"
        }
      },
      "id": "fcfb1a83-5b80-4ad0-ae16-0f9f126309bd",
      "name": "Start private job",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "options": {
          "timeout": 30000
        },
        "url": "={{ $env.PROTON_SORTER_URL + \"/api/tick\" }}"
      },
      "position": [
        300,
        100
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "b140b57a-ecf2-4e4e-a137-76ad0e9e65f6",
      "name": "Check previous run",
      "parameters": {
        "jsCode": "// Responses contain counters and run IDs only, never mail content or credentials.\nconst result = $input.first().json;\nif (result.previous && result.previous.status === 'failed') {\n  throw new Error('Previous Proton sorter job failed. Check the private worker logs and /api/status; completed changes remain applied.');\n}\nreturn [{json: result}];"
      },
      "position": [
        600,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    }
  ],
  "settings": {
    "errorWorkflow": "AutomationFail26",
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "timezone": "Europe/Berlin"
  }
