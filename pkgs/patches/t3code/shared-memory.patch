diff --git a/apps/server/src/memory/MemoryStore.ts b/apps/server/src/memory/MemoryStore.ts
new file mode 100644
index 00000000..0885a8da
--- /dev/null
+++ b/apps/server/src/memory/MemoryStore.ts
@@ -0,0 +1,118 @@
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Context from "effect/Context";
+import * as Cause from "effect/Cause";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+import * as ServerConfig from "../config.ts";
+import * as MemoryImport from "./MemoryImport.ts";
+
+export interface MemoryEntry {
+  readonly id: string;
+  readonly projectId: string | null;
+  readonly text: string;
+  readonly source: string;
+}
+
+export class MemoryStoreError extends Schema.TaggedError<MemoryStoreError>()("MemoryStoreError", {
+  cause: Schema.Defect(),
+}) {}
+
+export class MemoryStore extends Context.Service<
+  MemoryStore,
+  {
+    readonly put: (entry: MemoryEntry) => Effect.Effect<void, MemoryStoreError>;
+    readonly create: (entry: MemoryEntry) => Effect.Effect<void, MemoryStoreError>;
+    readonly remove: (id: string) => Effect.Effect<void, MemoryStoreError>;
+    readonly forProject: (
+      projectId: string,
+    ) => Effect.Effect<ReadonlyArray<MemoryEntry>, MemoryStoreError>;
+  }
+>()("t3/memory/MemoryStore") {}
+
+export const layer = Layer.effect(
+  MemoryStore,
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* sql`CREATE TABLE IF NOT EXISTS t3_memory (
+      id TEXT PRIMARY KEY,
+      project_id TEXT,
+      text TEXT NOT NULL,
+      source TEXT NOT NULL,
+      updated_at TEXT NOT NULL
+    )`.pipe(Effect.orDie);
+    yield* sql`CREATE INDEX IF NOT EXISTS t3_memory_project ON t3_memory (project_id)`.pipe(
+      Effect.orDie,
+    );
+    const fail = (cause: unknown) => new MemoryStoreError({ cause });
+    const put = Effect.fn("MemoryStore.put")(function* (entry: MemoryEntry) {
+      const updatedAt = DateTime.formatIso(yield* DateTime.now);
+      yield* sql`INSERT INTO t3_memory (id, project_id, text, source, updated_at)
+        VALUES (${entry.id}, ${entry.projectId}, ${entry.text}, ${entry.source}, ${updatedAt})
+        ON CONFLICT(id) DO UPDATE SET project_id = excluded.project_id, text = excluded.text,
+          source = excluded.source, updated_at = excluded.updated_at`.pipe(Effect.mapError(fail));
+    });
+    const create = Effect.fn("MemoryStore.create")(function* (entry: MemoryEntry) {
+      const updatedAt = DateTime.formatIso(yield* DateTime.now);
+      yield* sql`INSERT INTO t3_memory (id, project_id, text, source, updated_at)
+        VALUES (${entry.id}, ${entry.projectId}, ${entry.text}, ${entry.source}, ${updatedAt})
+        ON CONFLICT(id) DO NOTHING`.pipe(Effect.mapError(fail));
+    });
+    const remove = Effect.fn("MemoryStore.remove")(function* (id: string) {
+      yield* sql`DELETE FROM t3_memory WHERE id = ${id}`.pipe(Effect.mapError(fail));
+    });
+    const forProject = Effect.fn("MemoryStore.forProject")(function* (projectId: string) {
+      return yield* sql<MemoryEntry>`SELECT id, project_id AS "projectId", text, source
+        FROM t3_memory WHERE project_id IS NULL OR project_id = ${projectId}
+        ORDER BY project_id IS NOT NULL, id`.pipe(NodeSqliteClient.readOnly, Effect.mapError(fail));
+    });
+    return MemoryStore.of({ put, create, remove, forProject });
+  }),
+);
+
+export const layerConfig = Layer.unwrap(
+  Effect.gen(function* () {
+    const config = yield* ServerConfig.ServerConfig;
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const directory = path.join(config.stateDir, "memory");
+    yield* fs.makeDirectory(directory, { recursive: true, mode: 0o700 }).pipe(Effect.orDie);
+    yield* fs.chmod(directory, 0o700).pipe(Effect.orDie);
+    const databasePath = path.join(directory, "memory.sqlite");
+    yield* Effect.scoped(fs.open(databasePath, { flag: "a", mode: 0o600 })).pipe(Effect.orDie);
+    yield* fs.chmod(databasePath, 0o600).pipe(Effect.orDie);
+    const storeLayer = layer.pipe(
+      Layer.provide(NodeSqliteClient.layer({ filename: databasePath })),
+    );
+    return Layer.effect(
+      MemoryStore,
+      Effect.gen(function* () {
+        const store = yield* MemoryStore;
+        yield* MemoryImport.run(directory, store).pipe(
+          Effect.catchCause((cause) =>
+            Cause.hasInterruptsOnly(cause)
+              ? Effect.failCause(cause)
+              : Effect.logWarning(
+                  "T3 memory import is pending; the original files were not changed.",
+                ),
+          ),
+        );
+        return store;
+      }),
+    ).pipe(Layer.provide(storeLayer));
+  }),
+);
+
+export const layerEmpty = Layer.succeed(
+  MemoryStore,
+  MemoryStore.of({
+    put: Effect.fn("MemoryStore.put")(() => Effect.void),
+    create: Effect.fn("MemoryStore.create")(() => Effect.void),
+    remove: Effect.fn("MemoryStore.remove")(() => Effect.void),
+    forProject: Effect.fn("MemoryStore.forProject")(() => Effect.succeed([])),
+  }),
+);
