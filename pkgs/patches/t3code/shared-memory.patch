+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { expect, it } from "@effect/vitest";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import {
+  EnvironmentId,
+  ProjectId,
+  ProviderInstanceId,
+  ThreadId,
+  type Project,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Stream from "effect/Stream";
+
+import * as MemoryStore from "../../../memory/MemoryStore.ts";
+import * as ProjectService from "../../../project/ProjectService.ts";
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as McpToolAccess from "../../McpToolAccess.ts";
+import { liveThreadsLayer } from "../../McpToolAccess.testkit.ts";
+import * as MemoryHandlers from "./handlers.ts";
+import { MemoryToolkit } from "./tools.ts";
+
+const database = NodeSqliteClient.layer({ filename: ":memory:" });
+
+it.effect("keeps another project's memory out of the calling project's list", () =>
+  Effect.gen(function* () {
+    const toolkit = yield* MemoryToolkit;
+    const other = ProjectId.make("project:other");
+    const save = yield* toolkit
+      .handle("t3_memory_put", {
+        clientRequestId: "same-request",
+        scope: "project",
+        projectId: other,
+        text: "other private fact",
+        source: "test",
+      })
+      .pipe(Stream.unwrap, Stream.runCollect);
+    expect(save.at(-1)?.result).toMatchObject({ projectId: other, text: "other private fact" });
+    yield* toolkit
+      .handle("t3_memory_put", {
+        clientRequestId: "same-request",
+        scope: "project",
+        projectId: other,
+        text: "other private fact",
+        source: "test",
+      })
+      .pipe(Stream.unwrap, Stream.runCollect);
+    const current = yield* toolkit
+      .handle("t3_memory_list", {})
+      .pipe(Stream.unwrap, Stream.runCollect);
+    expect(current.at(-1)?.result).toMatchObject({ entries: [] });
+    const selected = yield* toolkit
+      .handle("t3_memory_list", { projectId: other })
+      .pipe(Stream.unwrap, Stream.runCollect);
+    expect(selected.at(-1)?.result).toMatchObject({ entries: [{ text: "other private fact" }] });
+  }).pipe(
+    Effect.provide(
+      McpToolAccess.HandlersLayer.layer(MemoryHandlers.layer).pipe(
