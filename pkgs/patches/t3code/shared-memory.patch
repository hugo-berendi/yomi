+import { assert, it } from "@effect/vitest";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+import * as ServerConfig from "../config.ts";
+
+import * as MemoryStore from "./MemoryStore.ts";
+
+const database = NodeSqliteClient.layer({ filename: ":memory:" });
+const layer = it.layer(Layer.merge(database, MemoryStore.layer.pipe(Layer.provide(database))));
+
+layer("MemoryStore", (it) => {
+  it.effect("persists updates and limits project memories to their own project", () =>
+    Effect.gen(function* () {
+      const store = yield* MemoryStore.MemoryStore;
+      yield* store.put({ id: "global", text: "Fish", projectId: null, source: "user" });
+      yield* store.put({ id: "a", text: "Bun", projectId: "a", source: "chat-a" });
+      yield* store.put({ id: "b", text: "npm", projectId: "b", source: "chat-b" });
+      yield* store.put({ id: "a", text: "pnpm", projectId: "a", source: "correction" });
+      assert.deepEqual(
+        (yield* store.forProject("a")).map((entry) => entry.text),
+        ["Fish", "pnpm"],
+      );
+      assert.deepEqual(
+        (yield* store.forProject("b")).map((entry) => entry.text),
+        ["Fish", "npm"],
+      );
+      yield* store.remove("global");
+      assert.deepEqual(
+        (yield* store.forProject("a")).map((entry) => entry.text),
+        ["pnpm"],
+      );
+    }),
+  );
+});
+
+it.effect("retains saved memories after the store is reopened", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    const file = path.join(directory, "memory.sqlite");
+    const storeLayer = () =>
+      MemoryStore.layer.pipe(Layer.provide(NodeSqliteClient.layer({ filename: file })));
+    yield* Effect.gen(function* () {
+      const store = yield* MemoryStore.MemoryStore;
+      yield* store.put({ id: "fish", projectId: null, text: "Fish", source: "user" });
+    }).pipe(Effect.provide(storeLayer()));
+    const entries = yield* Effect.gen(function* () {
+      const store = yield* MemoryStore.MemoryStore;
+      return yield* store.forProject("project");
+    }).pipe(Effect.provide(storeLayer()));
+    assert.deepEqual(
+      entries.map((entry) => entry.text),
+      ["Fish"],
+    );
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
+
+it.effect("stores the configured database privately inside T3 state", () =>
+  Effect.gen(function* () {
+    const config = yield* ServerConfig.ServerConfig;
