+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import * as NodeSqliteClient from "@t3tools/shared/nodeSqliteClient";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Path from "effect/Path";
+
+import * as MemoryImport from "./MemoryImport.ts";
+import * as MemoryStore from "./MemoryStore.ts";
+
+it.effect("imports staged memories once without removing the original", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    const sourcePath = path.join(directory, "source.md");
+    yield* fs.writeFileString(sourcePath, "Uses fish");
+    const requestPath = path.join(directory, "import.json");
+    yield* fs.writeFileString(
+      requestPath,
+      JSON.stringify({
+        version: 1,
+        sources: [{ path: sourcePath, content: "Uses fish" }],
+        entries: [{ id: "legacy:fish", projectId: null, text: "Uses fish", source: "source.md" }],
+      }),
+    );
+    const database = NodeSqliteClient.layer({ filename: ":memory:" });
+    yield* Effect.gen(function* () {
+      const store = yield* MemoryStore.MemoryStore;
+      yield* Effect.all([MemoryImport.run(directory, store), MemoryImport.run(directory, store)], {
+        concurrency: "unbounded",
+      });
+      yield* MemoryImport.run(directory, store);
+      assert.deepEqual(
+        (yield* store.forProject("project")).map((entry) => entry.text),
+        ["Uses fish"],
+      );
+      assert.isTrue(yield* fs.exists(sourcePath));
+      assert.isFalse(yield* fs.exists(requestPath));
+    }).pipe(Effect.provide(MemoryStore.layer.pipe(Layer.provide(database))));
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
+
+it.effect("does not import stale data when a source changed", () =>
+  Effect.gen(function* () {
+    const fs = yield* FileSystem.FileSystem;
+    const path = yield* Path.Path;
+    const directory = yield* fs.makeTempDirectoryScoped();
+    const sourcePath = path.join(directory, "source.md");
+    yield* fs.writeFileString(sourcePath, "new value");
+    const requestPath = path.join(directory, "import.json");
+    yield* fs.writeFileString(
+      requestPath,
+      JSON.stringify({
+        version: 1,
+        sources: [{ path: sourcePath, content: "old value" }],
+        entries: [{ id: "legacy:stale", projectId: null, text: "old value", source: "source.md" }],
+      }),
+    );
+    const database = NodeSqliteClient.layer({ filename: ":memory:" });
+    yield* Effect.gen(function* () {
+      const store = yield* MemoryStore.MemoryStore;
+      const result = yield* Effect.exit(MemoryImport.run(directory, store));
+      assert.equal(result._tag, "Failure");
+      assert.deepEqual(yield* store.forProject("project"), []);
+      assert.isTrue(yield* fs.exists(requestPath));
+    }).pipe(Effect.provide(MemoryStore.layer.pipe(Layer.provide(database))));
+  }).pipe(Effect.scoped, Effect.provide(NodeServices.layer)),
+);
diff --git a/apps/server/src/memory/MemoryImport.ts b/apps/server/src/memory/MemoryImport.ts
new file mode 100644
index 00000000..c5667935
--- /dev/null
+++ b/apps/server/src/memory/MemoryImport.ts
@@ -0,0 +1,81 @@
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+
+import type { MemoryStore } from "./MemoryStore.ts";
+
+export class MemoryImportError extends Schema.TaggedError<MemoryImportError>()(
+  "MemoryImportError",
+  {
+    reason: Schema.Literals(["source_changed", "entry_conflict"]),
+  },
+) {}
+
+const ImportRequest = Schema.Struct({
+  version: Schema.Literals([1]),
+  sources: Schema.Array(Schema.Struct({ path: Schema.String, content: Schema.String })),
+  entries: Schema.Array(
+    Schema.Struct({
+      id: Schema.String,
+      projectId: Schema.NullOr(Schema.String),
+      text: Schema.String,
+      source: Schema.String,
+    }),
+  ),
+});
+const decode = Schema.decodeUnknownEffect(Schema.fromJsonString(ImportRequest));
+
+export const run = Effect.fn("MemoryImport.run")(function* (
+  directory: string,
+  store: MemoryStore["Service"],
+) {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const request = path.join(directory, "import.json");
+  const completed = path.join(directory, "import.completed.json");
+  if (!(yield* fs.exists(request))) return;
+  const raw = yield* fs.readFileString(request).pipe(
+    Effect.catch((error) =>
+      Effect.gen(function* () {
+        if (!(yield* fs.exists(request)) && (yield* fs.exists(completed))) {
+          return yield* fs.readFileString(completed);
+        }
+        return yield* Effect.fail(error);
+      }),
+    ),
+  );
+  const payload = yield* decode(raw);
+  for (const source of payload.sources) {
+    if ((yield* fs.readFileString(source.path)) !== source.content) {
+      return yield* new MemoryImportError({ reason: "source_changed" });
+    }
+  }
+  for (const entry of payload.entries) {
+    yield* store.create(entry);
+    const saved = (yield* store.forProject(entry.projectId ?? "")).find(
+      (item) => item.id === entry.id,
+    );
+    if (
+      saved === undefined ||
+      saved.projectId !== entry.projectId ||
+      saved.text !== entry.text ||
+      saved.source !== entry.source
+    ) {
+      return yield* new MemoryImportError({ reason: "entry_conflict" });
+    }
+  }
+  yield* fs.rename(request, completed).pipe(
+    Effect.catch((error) =>
+      Effect.gen(function* () {
+        if (
+          !(yield* fs.exists(request)) &&
+          (yield* fs.exists(completed)) &&
+          (yield* fs.readFileString(completed)) === raw
+        )
+          return;
+        return yield* Effect.fail(error);
+      }),
+    ),
+  );
+});
