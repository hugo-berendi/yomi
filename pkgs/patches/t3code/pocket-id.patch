@@ -0,0 +1,97 @@
+import { afterEach, describe, expect, it } from "vite-plus/test";
+import { generateKeyPair, exportJWK, SignJWT } from "jose";
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { OidcLogin } from "./OidcLogin.ts";
+
+const dirs: string[] = [];
+afterEach(() => { for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+async function fixture(overrides: Record<string, unknown> = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "oidc-test-"));
+  dirs.push(dir);
+  const secret = join(dir, "secret");
+  writeFileSync(secret, "test-secret");
+  const { privateKey, publicKey } = await generateKeyPair("RS256");
+  const jwk = { ...await exportJWK(publicKey), kid: "test" };
+  let nonce = "";
+  let exchange: URLSearchParams | undefined;
+  const fetcher = (async (input, init) => {
+    const url = String(input);
+    if (url.endsWith("openid-configuration")) return Response.json({
+      issuer: "https://id.example", authorization_endpoint: "https://id.example/authorize",
+      token_endpoint: "https://id.example/token", jwks_uri: "https://id.example/jwks",
+    });
+    if (url.endsWith("jwks")) return Response.json({ keys: [jwk] });
+    exchange = new URLSearchParams(String(init?.body));
+    const token = await new SignJWT({ iss: "https://id.example", aud: "t3", sub: "owner", iat: Math.floor(Date.now()/1000), exp: Math.floor(Date.now()/1000)+300, nonce, email: "hugo@example.org", email_verified: true, ...overrides })
+      .setProtectedHeader({ alg: "RS256", kid: "test" }).sign(privateKey);
+    return Response.json({ id_token: token });
+  }) as typeof fetch;
+  const login = new OidcLogin({ issuer: "https://id.example", clientId: "t3", clientSecretFile: secret,
+    origin: "https://t3.example", allowedEmails: ["hugo@example.org"] }, fetcher);
+  const start = await login.begin();
+  const auth = new URL(start.url);
+  nonce = auth.searchParams.get("nonce")!;
+  const callback = new URL(`https://t3.example/auth/oidc/callback?code=test&state=${auth.searchParams.get("state")}`);
+  return { login, start, auth, callback, exchange: () => exchange };
+}
+
+describe("Pocket ID login", () => {
+  it("exchanges a browser-bound code with PKCE and authenticates the verified owner", async () => {
+    const f = await fixture();
+    expect(f.auth.searchParams.get("code_challenge_method")).toBe("S256");
+    expect(await f.login.complete(f.callback, f.start.binding)).toBe("owner");
+    expect(f.exchange()?.get("redirect_uri")).toBe("https://t3.example/auth/oidc/callback");
+    expect(f.exchange()?.get("code_verifier")).toHaveLength(43);
+    await expect(f.login.complete(f.callback, f.start.binding)).rejects.toThrow();
+  });
+  it("rejects a callback from a different browser", async () => {
+    const f = await fixture();
+    await expect(f.login.complete(f.callback, "another-browser")).rejects.toThrow();
+    expect(f.exchange()).toBeUndefined();
+  });
+  it.each([
+    { nonce: "wrong" }, { email_verified: false }, { email: "stranger@example.org" },
+    { azp: "other-client" }, { aud: "other-client" }, { iss: "https://wrong.example" },
+    { exp: 1 },
+  ])("rejects invalid identity claims %j", async (claims) => {
+    const f = await fixture(claims);
+    await expect(f.login.complete(f.callback, f.start.binding)).rejects.toThrow();
+  });
+});
+
+// Exercise the HTTP boundary too: a verified login must set the same cookie
+// the unmodified client uses, with secure attributes and the server expiry.
+it("sets the normal session cookie after an OIDC callback", async () => {
+  const f = await fixture();
+  const Effect = await import("effect/Effect");
+  const Layer = await import("effect/Layer");
+  const DateTime = await import("effect/DateTime");
+  const HttpRouter = await import("effect/http/HttpRouter");
+  const SessionStore = await import("./SessionStore.ts");
+  const { makeLayer } = await import("./oidcHttp.ts");
+  let subject: string | undefined;
+  const sessions = {
+    cookieName: "t3-session",
+    issue: (input: { subject?: string }) => {
+      subject = input.subject;
+      return Effect.succeed({ token: "session-token", expiresAt: DateTime.makeUnsafe("2030-01-01T00:00:00Z") });
+    },
+  } as import("./SessionStore.ts").SessionStore["Service"];
+  const { handler, dispose } = HttpRouter.toWebHandler(makeLayer(f.login).pipe(
+    Layer.provide(Layer.succeed(SessionStore.SessionStore, sessions)),
+  ));
+  try {
+    const response = await handler(new Request(f.callback, { headers: { cookie: `__Host-t3-oidc=${f.start.binding}` } }));
+    expect(response.status).toBe(302);
+    expect(response.headers.get("location")).toBe("/");
+    const cookie = response.headers.get("set-cookie")!;
+    expect(cookie).toContain("t3-session=session-token");
+    expect(cookie.toLowerCase()).toContain("httponly");
+    expect(cookie.toLowerCase()).toContain("secure");
+    expect(cookie.toLowerCase()).toContain("samesite=lax");
+    expect(response.headers.get("cache-control")).toBe("no-store");
+    expect(subject).toBe("oidc:owner");
+  } finally { await dispose(); }
+});
diff --git a/apps/server/src/auth/OidcLogin.ts b/apps/server/src/auth/OidcLogin.ts
new file mode 100644
index 00000000..9fcfc261
--- /dev/null
+++ b/apps/server/src/auth/OidcLogin.ts
@@ -0,0 +1,107 @@
+import { createHash, randomBytes } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { createLocalJWKSet, jwtVerify } from "jose";
+
+export interface OidcConfig {
+  issuer: string;
+  clientId: string;
+  clientSecretFile: string;
+  origin: string;
+  allowedEmails: string[];
+}
+
+const random = () => randomBytes(32).toString("base64url");
+const digest = (value: string) => createHash("sha256").update(value).digest("base64url");
+const httpsUrl = (value: string) => {
+  const url = new URL(value);
+  if (url.protocol !== "https:" || url.username || url.password || url.hash) {
+    throw new Error("OIDC requires HTTPS URLs without credentials or fragments");
+  }
+  return url;
+};
+
+/** Each login is short lived, single use and bound to the initiating browser. */
+export class OidcLogin {
+  private readonly pending = new Map<string, {
+    binding: string; nonce: string; verifier: string; expires: number;
+  }>();
+  readonly callback: string;
+
+  constructor(readonly config: OidcConfig, private readonly fetcher: typeof fetch = fetch) {
+    const origin = httpsUrl(config.origin);
+    if (origin.origin !== config.origin || !config.clientId || !config.clientSecretFile ||
+        !Array.isArray(config.allowedEmails) || config.allowedEmails.length === 0 ||
+        config.allowedEmails.some((email) => typeof email !== "string" || !email.trim())) {
+      throw new Error("Incomplete OIDC configuration");
+    }
+    httpsUrl(config.issuer);
+    this.callback = `${origin.origin}/auth/oidc/callback`;
+  }
+
+  private async json(url: string, init?: RequestInit): Promise<any> {
+    const response = await this.fetcher(httpsUrl(url), {
+      ...init, redirect: "error", signal: AbortSignal.timeout(10_000),
+    });
+    if (!response.ok) throw new Error("OIDC provider request failed");
+    return response.json();
+  }
+
+  private async discovery() {
+    const metadata = await this.json(`${this.config.issuer.replace(/\/$/, "")}/.well-known/openid-configuration`);
+    if (metadata.issuer !== this.config.issuer) throw new Error("OIDC issuer mismatch");
+    for (const key of ["authorization_endpoint", "token_endpoint", "jwks_uri"]) httpsUrl(metadata[key]);
+    return metadata;
+  }
+
+  async begin() {
+    const metadata = await this.discovery();
+    const now = Date.now();
+    for (const [key, entry] of this.pending) if (entry.expires <= now) this.pending.delete(key);
+    if (this.pending.size >= 256) throw new Error("Too many pending OIDC logins");
+    const state = random();
+    const binding = random();
+    const nonce = random();
+    const verifier = random();
+    this.pending.set(state, { binding: digest(binding), nonce, verifier, expires: now + 300_000 });
+    const url = new URL(metadata.authorization_endpoint);
+    url.search = new URLSearchParams({
+      client_id: this.config.clientId, redirect_uri: this.callback,
+      response_type: "code", scope: "openid email profile", state, nonce,
+      code_challenge: digest(verifier), code_challenge_method: "S256",
+    }).toString();
+    return { url: url.href, binding };
+  }
+
+  async complete(url: URL, binding: string | undefined): Promise<string> {
+    const state = url.searchParams.get("state") ?? "";
+    const pending = this.pending.get(state);
+    this.pending.delete(state);
+    if (!pending || pending.expires <= Date.now() || !binding ||
+        digest(binding) !== pending.binding || url.searchParams.has("error") ||
+        !url.searchParams.get("code")) throw new Error("Invalid OIDC login transaction");
+    const metadata = await this.discovery();
+    const token = await this.json(metadata.token_endpoint, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams({
+        grant_type: "authorization_code", code: url.searchParams.get("code")!,
+        redirect_uri: this.callback, client_id: this.config.clientId,
+        client_secret: readFileSync(this.config.clientSecretFile, "utf8").trim(),
+        code_verifier: pending.verifier,
+      }).toString(),
+    });
+    const jwks = createLocalJWKSet(await this.json(metadata.jwks_uri));
+    const { payload } = await jwtVerify(token.id_token, jwks, {
+      issuer: this.config.issuer, audience: this.config.clientId,
+      algorithms: ["RS256", "ES256", "EdDSA"], requiredClaims: ["sub", "iat", "exp", "nonce"],
+    });
+    if (payload.nonce !== pending.nonce || !payload.sub ||
+        (payload.azp !== undefined && payload.azp !== this.config.clientId) ||
+        (Array.isArray(payload.aud) && payload.aud.length > 1 && payload.azp !== this.config.clientId) ||
+        payload.email_verified !== true || typeof payload.email !== "string" ||
+        !this.config.allowedEmails.some((email) => email.toLowerCase() === (payload.email as string).toLowerCase())) {
+      throw new Error("OIDC account is not authorized");
+    }
+    return payload.sub;
+  }
+}
diff --git a/apps/server/src/auth/oidcHttp.ts b/apps/server/src/auth/oidcHttp.ts
new file mode 100644
index 00000000..1ca64700
--- /dev/null
+++ b/apps/server/src/auth/oidcHttp.ts
@@ -0,0 +1,50 @@
+import { readFileSync } from "node:fs";
+import * as DateTime from "effect/DateTime";
+import * as Duration from "effect/Duration";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import { HttpRouter, HttpServerRequest, HttpServerResponse } from "effect/http";
+import { OidcLogin, type OidcConfig } from "./OidcLogin.ts";
+import * as SessionStore from "./SessionStore.ts";
+import { deriveAuthClientMetadata } from "./utils.ts";
+
+const cookieName = "__Host-t3-oidc";
+const cookieOptions = { httpOnly: true, secure: true, sameSite: "lax" as const, path: "/" };
+const noStore = { "cache-control": "no-store", "referrer-policy": "no-referrer" };
+
+// Explicit opt-in. Invalid configuration fails startup rather than bypassing login.
+export const makeLayer = (login: OidcLogin) => Layer.unwrap(Effect.gen(function* () {
+  const sessions = yield* SessionStore.SessionStore;
+  const guarded = <A, E, R>(effect: Effect.Effect<A, E, R>) => effect.pipe(
+    Effect.catch(() => Effect.succeed(HttpServerResponse.text("Pocket ID login failed. Start again at /auth/oidc/login.", {
+      status: 403, headers: noStore,
+    }))),
+  );
+  return Layer.mergeAll(
+    HttpRouter.add("GET", "/auth/oidc/login", guarded(Effect.gen(function* () {
+      const result = yield* Effect.tryPromise(() => login.begin());
+      return HttpServerResponse.redirect(result.url, { headers: noStore }).pipe(
+        HttpServerResponse.setCookieUnsafe(cookieName, result.binding, { ...cookieOptions, maxAge: Duration.minutes(5) }),
+      );
+    }))),
+    HttpRouter.add("GET", "/auth/oidc/callback", guarded(Effect.gen(function* () {
+      const request = yield* HttpServerRequest.HttpServerRequest;
+      const sub = yield* Effect.tryPromise(() => login.complete(new URL(request.url, login.config.origin), request.cookies[cookieName]));
+      const session = yield* sessions.issue({
+        subject: `oidc:${sub}`, ttl: Duration.hours(12),
+        method: "browser-session-cookie", client: deriveAuthClientMetadata({ request }),
+      });
+      return HttpServerResponse.redirect("/", { headers: noStore }).pipe(
+        HttpServerResponse.setCookieUnsafe(sessions.cookieName, session.token, {
+          ...cookieOptions, expires: DateTime.toDate(session.expiresAt),
+        }),
+        HttpServerResponse.setCookieUnsafe(cookieName, "", { ...cookieOptions, maxAge: 0 }),
+      );
+    }))),
+  );
+}));
+
+export const layer = Layer.unwrap(Effect.sync(() => {
+  const file = process.env.T3CODE_OIDC_CONFIG;
+  return file ? makeLayer(new OidcLogin(JSON.parse(readFileSync(file, "utf8")) as OidcConfig)) : Layer.empty;
+}));
